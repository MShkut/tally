{
  "name": "tally-desktop",
  "version": "0.1.5",
  "description": "Tally - Privacy-first household budget tracker",
  "main": "electron/main.js",
  "author": "Tally",
  "license": "MIT",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "npm run build:frontend && npm run build:backend && electron-builder",
    "electron:build:mac": "npm run build:frontend && npm run build:backend && electron-builder --mac",
    "electron:build:win": "npm run build:frontend && npm run build:backend && electron-builder --win",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "cd backend && npm install",
    "postinstall": "electron-builder install-app-deps && cd backend && npm install"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.tally.budget",
    "productName": "Tally",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*"
    ],
    "asarUnpack": [
      "backend/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "electron/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "electron/icons/icon.png",
      "category": "Finance",
      "target": ["AppImage", "deb"]
    }
  }
}
