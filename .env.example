# Tally Budget - Docker Environment Configuration
# Copy this file to .env and configure for your environment

# Production Port (default: 8085)
# Access production version at http://your-server-ip:8085
TALLY_PORT=8085

# Development Port (default: 8086)
# Access development version at http://your-server-ip:8086
TALLY_DEV_PORT=8086

# GitHub Container Registry Authentication
# To pull private images, run: docker login ghcr.io
# Username: your-github-username
# Password: GitHub Personal Access Token (PAT) with 'read:packages' scope
# Create PAT at: https://github.com/settings/tokens/new
